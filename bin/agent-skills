#!/usr/bin/env bash
# agent-skills — one stable entry point, resolvable from any repository.
#
# This is the command every globally installed skill invokes, and the command
# users type. It exists so a skill never has to guess a relative path, and so
# the product has one durable name that survives changes to how it is
# distributed.
#
# It resolves its own real location through any number of symlinks, which is how
# it always reaches helpers from its own release:
#
#   ~/.local/bin/agent-skills
#     -> ~/.agent-skills/bin/agent-skills
#       -> ~/.agent-skills/current/bin/agent-skills
#         -> ~/.agent-skills/versions/<active>/bin/agent-skills
#
# Run `agent-skills help` for the command list.

set -uo pipefail

AS_SELF="${BASH_SOURCE[0]}"
while [ -L "${AS_SELF}" ]; do
  AS_SELF_DIR="$(cd -P "$(dirname "${AS_SELF}")" >/dev/null 2>&1 && pwd)"
  AS_SELF_LINK="$(readlink "${AS_SELF}")"
  case "${AS_SELF_LINK}" in
    /*) AS_SELF="${AS_SELF_LINK}" ;;
    *) AS_SELF="${AS_SELF_DIR}/${AS_SELF_LINK}" ;;
  esac
done
AS_BIN_DIR="$(cd -P "$(dirname "${AS_SELF}")" >/dev/null 2>&1 && pwd)"
AS_LIB_DIR="${AS_BIN_DIR}/../lib"
AS_LIB_DIR="$(cd -P "${AS_LIB_DIR}" >/dev/null 2>&1 && pwd)"
export AS_LIB_DIR

# shellcheck source=lib/runtime.sh
. "${AS_LIB_DIR}/runtime.sh"

AS_SOURCE_DIR="$(as_source_dir 2>/dev/null || true)"
PYTHON3="${PYTHON3:-python3}"

# Exit codes are a public contract; see lib/asrelease/exits.py.
AS_EXIT_USAGE=2

usage() {
  cat <<'EOF'
Usage: agent-skills <command> [options]

Installation and releases
  install               Install Agent Skills on this machine
  update                Move to the latest release, transactionally
  rollback              Return to the previously installed release
  versions              List installed and available releases
  check-updates         Compare the installed version against the latest release
  verify                Check the installation and report problems (no writes)
                        --quiet | --explain-codes
  doctor                Report what this environment can actually do
  hosts [--json]        List supported hosts and their global discovery paths
  provider              Where releases come from, and whether it is reachable
  uninstall             Remove agent-skills-owned links, hooks, and releases
  dev <install|...>     Development install from a local source tree
  migrate               Explain how to move off a pre-0.43 installation

Task lifecycle
  start-task [args]     Mandatory preflight: memory, knowledge, capability report
  finish-task [args]    Write durable memory, then clean up per-task scratch
  dod-check <file>      Verify a definition-of-done.json as evidence (0 verified, 1 not)

Context and access
  project [--json]      Show the project context inferred from this repository
  access <subcommand>   Resolve access to an external service (see below)
  context <subcommand>  Context Optimizer: bound a large input (see below)
  tools <subcommand>    Engineering Tool Capability Framework (see below)

Runtime safety
  guard <subcommand>    Execution Guard: decide before an action runs (see below)
  redact [--check]      Strip credential-shaped values from text on stdin

Adaptive execution
  execution-profile     Choose LIGHT / STANDARD / RIGOROUS for a task or phase
  watchdog [args]       Ask whether a running task is still making progress

Memory and helpers
  memory [args]         Per-project memory (project-memory.py)
  knowledge [args]      Repo-resident knowledge base (knowledge.py)
  blackboard [args]     Per-task shared working memory (blackboard.py)
  org-memory [args]     Cross-project memory tier (org-memory.py)
  telemetry [args]      Append-only event log (telemetry.py)
  plan-next [args]      Read the next actionable phase of a delivery plan
  locate-config [args]  Locate legacy .env / tracker config files
  auth-preflight [args] Legacy tracker auth check; prefer `access resolve`

Other
  version               Print the active version
  help                  Show this message

Install and update options:
  --version X           Install or update to this exact release
  --channel stable|rc   Which release line to follow. Remembered: pass it once,
                        later commands stay on that line (default: stable)
  --source DIR          Install from a local source tree instead of the remote
  --repo URL            Use a different git remote as the release source
  --provider local|git  Choose the release provider explicitly
  --hosts a,b,c         Register only these host ids
  --all-hosts           Register every linkable host, detected or not
  --no-path-link        Do not link the launcher into a PATH directory
  --allow-downgrade     Permit replacing the active release with an older one
  --keep N              How many releases to retain for rollback (default: 2)
  --purge               With uninstall: also remove credential metadata

Access subcommands (see docs/access-resolution.md):
  access resolve --service NAME [--resource URI] [--require f1,f2] [--secret f]
  access profiles [--json]        List credential identities (never values)
  access set --profile NAME --service NAME --field k=v [--secret-field k]
  access bind --service NAME --profile NAME
  access unbind --service NAME
  access forget --profile NAME
  access backend                  Report the secret-storage backend in use
  access import-legacy            Offer to move legacy .env credentials in

Context subcommands (see docs/context-optimizer.md):
  context inspect <path>          Cheap metadata and structure; no model, no full read
  context check <path>...         Past the large-input threshold? Exit 10 when it is
  context pack <path> --brief T [--budget-chars N] [--strategy S] [--format F]
  context explain <pack>          Provenance, metrics, and staleness of a built pack
  context expand <pack> --fragment ID   Widen one region without rebuilding
  context cache path|list|clear   Manage the deterministic pack cache

Before reading an input past the threshold, build a pack instead. Selection is
deterministic and task-aware, every fragment is traceable, and every omission is
reported. Source text is data, never instructions.

Tools subcommands (see docs/engineering-tools.md):
  tools list [--class C] [--category C] [--include-fixtures]
  tools status                     Per-tool availability on this machine (no secrets)
  tools inspect <id>               Class, capabilities, transports, resolution result
  tools classify <id> <capability> Print READ | WRITE | ELEVATED | DESTRUCTIVE
  tools resolve <id> --capability <c> [--allow-write]
  tools capabilities               The provider-neutral capability vocabulary
  tools classes                    The tool classes and transport resolution order
  tools doctor                     Registry integrity and coherence checks

A skill names a capability; the resolver picks a transport, preferring one the
environment already has (host, MCP, authenticated CLI, local tool) over a stored
secret. It never authenticates — that stays with `access` — and it never
enforces — that stays with `guard`. It only classifies the action so a skill
knows the blast radius first.

Guard subcommands (see docs/execution-guard.md):
  guard check-command [--cwd P] [--format F] -- '<command>'
  guard check-tool --host <id>     Host pre-execution hook entry point
  guard explain -- '<command>'     Why a command resolves the way it does
  guard scan-content <path>...     Flag instruction-shaped untrusted text
  guard rules [--format json]      The rule catalogue and its effective outcomes
  guard audit [--tail N] [--clear]  The local, redacted decision log
  guard run -- '<command>'         Wrapper mode for hosts with no hook
  guard install|reconcile|verify|uninstall|doctor

The guard is a second layer under the destructive-action policy, not a
replacement for it. Skill policy is the semantic contract; the guard is the
technical enforcement point where a host offers one. Exit codes for
check-command: 0 allow, 10 ask, 20 deny.

Exit codes (stable): 0 ok, 2 usage, 3 authentication required, 4 network,
5 integrity, 6 installation failed, 7 verification failed, 10 update available.

Nothing in `install` asks for a credential. Reading the release source may need
the git access you already have; that is distribution access, and it is never
used for your projects. See docs/installation.md and docs/access-resolution.md.
EOF
}

require_source() {
  if [ -z "${AS_SOURCE_DIR}" ]; then
    as_die "no active Agent Skills release found. Install it with: agent-skills install" 6
  fi
}

# Delegate to a script inside the resolved release, so the helper and the
# launcher always come from the same version.
run_script() {
  local relative="$1"
  shift
  require_source
  local path="${AS_SOURCE_DIR}/${relative}"
  if [ ! -f "${path}" ]; then
    as_die "missing helper: ${path}" 6
  fi
  case "${relative}" in
    *.py) exec "${PYTHON3}" "${path}" "$@" ;;
    *) exec bash "${path}" "$@" ;;
  esac
}

# The install engine. Unlike run_script this must work before anything is
# installed, so it resolves relative to this launcher rather than to the
# active release: `npx <package> install` runs the launcher out of a freshly
# downloaded payload with nothing active yet.
run_installer() {
  local engine="${AS_BIN_DIR}/../scripts/install.py"
  if [ ! -f "${engine}" ]; then
    require_source
    engine="${AS_SOURCE_DIR}/scripts/install.py"
  fi
  exec "${PYTHON3}" "${engine}" "$@"
}

COMMAND="${1:-help}"
[ "$#" -gt 0 ] && shift

case "${COMMAND}" in
  install|update|rollback|versions|check-updates|provider)
    run_installer "${COMMAND}" "$@"
    ;;

  dev)
    # Development install from a working tree. Distinct from `install` so a
    # maintainer's unreleased branch can never be mistaken for a release, and
    # so `agent-skills versions` shows which is which.
    SUB="${1:-install}"
    [ "$#" -gt 0 ] && shift
    case "${SUB}" in
      install)
        SOURCE_ARG=""
        case " $* " in
          *" --source "*|*" --source="*) : ;;
          *) SOURCE_ARG="--source $(pwd)" ;;
        esac
        # shellcheck disable=SC2086
        run_installer install --provider local ${SOURCE_ARG} --dev "$@"
        ;;
      *) as_die "unknown dev subcommand: ${SUB}" "${AS_EXIT_USAGE}" ;;
    esac
    ;;

  verify)
    # shellcheck source=lib/install.sh
    . "${AS_LIB_DIR}/install.sh"
    AS_VERIFY_QUIET="false"
    AS_VERIFY_EXPLAIN="false"
    for arg in "$@"; do
      case "${arg}" in
        --quiet) AS_VERIFY_QUIET="true" ;;
        --explain-codes) AS_VERIFY_EXPLAIN="true" ;;
        *) as_die "unknown option for verify: ${arg}" "${AS_EXIT_USAGE}" ;;
      esac
    done
    if [ "${AS_VERIFY_EXPLAIN}" = "true" ]; then
      # The exit codes are a frozen public contract, so they need a way to be
      # read that is not "grep the source". This was documented in
      # lib/asrelease/exits.py as an existing flag before it existed.
      as_explain_exit_codes
      exit 0
    fi
    if [ "${AS_VERIFY_QUIET}" = "true" ]; then
      as_verify_install >/dev/null 2>&1
      exit $?
    fi
    as_verify_install
    ;;

  uninstall)
    . "${AS_LIB_DIR}/install.sh"
    AS_OPT_PURGE="false"
    AS_OPT_YES="false"
    for arg in "$@"; do
      case "${arg}" in
        --purge) AS_OPT_PURGE="true" ;;
        --yes|-y) AS_OPT_YES="true" ;;
        *) as_die "unknown option for uninstall: ${arg}" "${AS_EXIT_USAGE}" ;;
      esac
    done
    export AS_OPT_PURGE
    if [ "${AS_OPT_YES}" != "true" ] && [ -t 0 ]; then
      printf 'Remove agent-skills releases, host registrations, and hooks? [y/N] '
      read -r reply
      case "${reply}" in
        y|Y|yes|YES) : ;;
        *) printf 'Cancelled.\n'; exit 0 ;;
      esac
    fi
    as_uninstall_global
    ;;

  hosts)
    . "${AS_LIB_DIR}/install.sh"
    AS_OPT_JSON="false"
    for arg in "$@"; do
      case "${arg}" in
        --json) AS_OPT_JSON="true" ;;
        *) as_die "unknown option for hosts: ${arg}" "${AS_EXIT_USAGE}" ;;
      esac
    done
    as_list_hosts "${AS_OPT_JSON}"
    ;;

  migrate)
    require_source
    exec bash "${AS_SOURCE_DIR}/lib/migrate.sh" "$@"
    ;;

  # Run by the install transaction against a staged release, before anything
  # points at it. A release that cannot answer this is never activated.
  self-test)
    RELEASE_DIR="$(cd -P "${AS_BIN_DIR}/.." >/dev/null 2>&1 && pwd)"
    rc=0
    version="$(as_read_version_file "${RELEASE_DIR}/VERSION" 2>/dev/null || printf '')"
    if [ -z "${version}" ]; then
      printf 'self-test: no readable VERSION in %s\n' "${RELEASE_DIR}" >&2
      exit 6
    fi
    for required in \
      lib/runtime.sh lib/install.sh lib/hosts.registry lib/guard.registry \
      scripts/install.py scripts/hosts-reconcile.sh scripts/doctor.sh \
      scripts/start-task.sh scripts/finish-task.sh scripts/access.py \
      scripts/guard.py scripts/context.py scripts/tools.py \
      scripts/redact.py scripts/execution-profile.py \
      scripts/execution-watchdog.py \
      lib/tools/capabilities.json lib/tools/classes.json; do
      if [ ! -f "${RELEASE_DIR}/${required}" ]; then
        printf 'self-test: missing %s\n' "${required}" >&2
        rc=6
      fi
    done
    for script in "${RELEASE_DIR}"/lib/*.sh "${RELEASE_DIR}"/scripts/*.sh; do
      [ -f "${script}" ] || continue
      bash -n "${script}" || rc=6
    done
    if ! "${PYTHON3}" - "${RELEASE_DIR}" <<'SELFTEST'
import os
import sys

root = sys.argv[1]
sys.path.insert(0, os.path.join(root, "lib"))
import asrelease  # noqa: F401
from asrelease.release import read_version_file

failures = []
for name in sorted(os.listdir(os.path.join(root, "scripts"))):
    if not name.endswith(".py"):
        continue
    path = os.path.join(root, "scripts", name)
    try:
        compile(open(path, encoding="utf-8").read(), path, "exec")
    except SyntaxError as exc:
        failures.append("{}: {}".format(name, exc))
if not read_version_file(root):
    failures.append("VERSION is not readable through the release module")
skills = os.path.join(root, "skills")
found = [
    name
    for name in os.listdir(skills)
    if os.path.isfile(os.path.join(skills, name, "SKILL.md"))
]
if not found:
    failures.append("release ships no skills")
for line in failures:
    sys.stderr.write("self-test: {}\n".format(line))
sys.exit(1 if failures else 0)
SELFTEST
    then
      rc=6
    fi
    [ "${rc}" -eq 0 ] && printf 'self-test ok: %s\n' "${version}"
    exit "${rc}"
    ;;

  start-task) run_script "scripts/start-task.sh" "$@" ;;
  finish-task) run_script "scripts/finish-task.sh" "$@" ;;
  dod-check) run_script "scripts/dod-check.py" "$@" ;;
  doctor) run_script "scripts/doctor.sh" "$@" ;;
  access) run_script "scripts/access.py" "$@" ;;
  guard) run_script "scripts/guard.py" "$@" ;;
  redact) run_script "scripts/redact.py" "$@" ;;
  project) run_script "scripts/project-context.py" "$@" ;;
  context) run_script "scripts/context.py" "$@" ;;
  tools) run_script "scripts/tools.py" "$@" ;;

  # Every helper is reachable through this one command, so a skill never has to
  # guess whether the scripts live at `scripts/`, `agent-skills/scripts/`, or
  # `.agent-skills/scripts/`.
  memory) run_script "scripts/project-memory.py" "$@" ;;
  knowledge) run_script "scripts/knowledge.py" "$@" ;;
  blackboard) run_script "scripts/blackboard.py" "$@" ;;
  org-memory) run_script "scripts/org-memory.py" "$@" ;;
  telemetry) run_script "scripts/telemetry.py" "$@" ;;
  plan-next) run_script "scripts/delivery-run-next.py" "$@" ;;
  execution-profile) run_script "scripts/execution-profile.py" "$@" ;;
  watchdog) run_script "scripts/execution-watchdog.py" "$@" ;;
  locate-config) run_script "scripts/locate-config.py" "$@" ;;
  auth-preflight) run_script "scripts/auth-preflight.py" "$@" ;;
  promote-rules) run_script "scripts/promote-rules.py" "$@" ;;
  outcome) run_script "scripts/outcome-recorder.py" "$@" ;;
  github-access) run_script "scripts/github-access.sh" "$@" ;;

  version)
    if as_is_installed; then
      printf '%s\n' "$(as_installed_version || printf 'unknown')"
    else
      printf '%s (not installed)\n' "$(as_source_version || printf 'unknown')"
    fi
    ;;

  help|--help|-h) usage ;;

  *)
    printf 'agent-skills: unknown command %s\n\n' "${COMMAND}" >&2
    usage >&2
    exit "${AS_EXIT_USAGE}"
    ;;
esac
