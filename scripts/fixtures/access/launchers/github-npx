#!/bin/sh
# vandelay wrapper (fixture): github upstream via docker, gh token from netrc-less env
if [ "${VANDELAY_GH_WRITE:-0}" != "1" ]; then
  export GITHUB_READ_ONLY=1
fi
touch "${ACME_FIXTURE_RAN_MARKER:-/dev/null}"
exec docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN -e GITHUB_READ_ONLY ghcr.io/github/github-mcp-server
