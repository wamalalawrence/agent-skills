#!/usr/bin/env python3
"""A minimal stdio MCP server for tests. FAKE_MCP_MODE: rw | ro | hang | crash."""
import json, os, sys, time
mode = os.environ.get("FAKE_MCP_MODE", "rw")
if mode == "crash":
    sys.exit(3)
tools = ["confluence_get_page", "confluence_search"]
if mode == "rw" and os.environ.get("READ_ONLY_MODE", "").lower() not in ("true", "1"):
    tools += ["confluence_update_page", "confluence_create_page"]
for line in sys.stdin:
    msg = json.loads(line)
    if mode == "hang":
        time.sleep(30)
    if msg.get("method") == "initialize":
        out = {"jsonrpc": "2.0", "id": msg["id"], "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}},
               "serverInfo": {"name": "fake-atlassian", "version": "0"}}}
    elif msg.get("method") == "tools/list":
        out = {"jsonrpc": "2.0", "id": msg["id"], "result": {"tools": [{"name": t} for t in tools]}}
    else:
        continue
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()
