#!/usr/bin/env python3
"""A fake whisper-cli (whisper.cpp) for the offline desktop tests.

Reads `-f <wav>`, writes `<-of prefix>.json` in whisper.cpp's -oj shape. What it
"hears" comes from FAKE_WHISPER_SCRIPT (a JSON file: {"0": [[from_ms, to_ms,
text], ...], "1": [...]}) keyed by the channel in the chunk's file name
(c0_ / c1_ / self-test-c0 ...); only chunk 0000 of each channel has speech.
Every invocation's arguments are appended to FAKE_WHISPER_LOG.
"""
import json
import os
import re
import sys
import wave

args = sys.argv[1:]
wav = args[args.index("-f") + 1]
prefix = args[args.index("-of") + 1]
language = args[args.index("-l") + 1] if "-l" in args else "auto"
log = os.environ.get("FAKE_WHISPER_LOG")
if log:
    with open(log, "a") as handle:
        handle.write(json.dumps(args) + "\n")
if os.environ.get("FAKE_WHISPER_FAIL"):
    sys.exit(3)
with wave.open(wav, "rb") as source:  # proves the input is a readable mono 16 kHz WAV
    assert source.getnchannels() == 1 and source.getframerate() == 16000
name = os.path.basename(wav)
match = re.search(r"c(\d)(?:_(\d{4}))?", name)
channel, chunk = (match.group(1), match.group(2) or "0000") if match else ("0", "0000")
script = {}
if os.environ.get("FAKE_WHISPER_SCRIPT"):
    with open(os.environ["FAKE_WHISPER_SCRIPT"]) as handle:
        script = json.load(handle)
rows = script.get(channel, []) if chunk == "0000" else []
payload = {
    "result": {"language": "de" if language == "auto" else language},
    "transcription": [{"offsets": {"from": a, "to": b}, "text": " " + t} for a, b, t in rows]
    + [{"offsets": {"from": 0, "to": 0}, "text": " [BLANK_AUDIO]"}],
}
with open(prefix + ".json", "w") as handle:
    json.dump(payload, handle)
