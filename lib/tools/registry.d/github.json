{
  "schema": "agent-skills.tool-definition/v1",
  "id": "github",
  "class": "REMOTE_SERVICE",
  "category": "source-control",
  "summary": "GitHub repositories, pull requests, issues, and GitHub Actions runs.",
  "capabilities": [
    "scm.repository.read",
    "scm.pull_request.read",
    "scm.pull_request.write",
    "scm.issue.read",
    "scm.issue.write",
    "scm.branch.write",
    "scm.release.read",
    "ci.run.read",
    "ci.logs.read",
    "ci.artifact.read"
  ],
  "transports": [
    {
      "kind": "host"
    },
    {
      "kind": "mcp",
      "hint": "github"
    },
    {
      "kind": "cli",
      "command": "gh",
      "probe": [
        "auth",
        "status"
      ]
    },
    {
      "kind": "api",
      "auth_service": "github",
      "require": [
        "token"
      ],
      "secret": [
        "token"
      ]
    }
  ],
  "auth_service": "github",
  "docs": "docs/github-access.md",
  "bounded_capabilities": [
    "ci.logs.read"
  ],
  "reference_status": "validated",
  "notes": "Reuses the existing GitHub access ladder (scripts/github-access.sh). GitHub Actions is not a separate tool: ci.* rides the same transports. See github-actions.json for the CI-provider view."
}
