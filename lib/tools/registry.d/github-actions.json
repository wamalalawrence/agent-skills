{
  "schema": "agent-skills.tool-definition/v1",
  "id": "github-actions",
  "class": "REMOTE_SERVICE",
  "category": "ci-cd",
  "summary": "CI-provider view of GitHub Actions: runs, job logs, artifacts. Delegates transport to the github tool.",
  "capabilities": [
    "ci.run.read",
    "ci.logs.read",
    "ci.artifact.read",
    "ci.run.trigger"
  ],
  "transports": [
    {
      "kind": "host"
    },
    {
      "kind": "mcp",
      "hint": "github"
    },
    {
      "kind": "cli",
      "command": "gh",
      "probe": [
        "auth",
        "status"
      ]
    },
    {
      "kind": "api",
      "auth_service": "github",
      "require": [
        "token"
      ],
      "secret": [
        "token"
      ]
    }
  ],
  "auth_service": "github",
  "delegates_to": "github",
  "docs": "docs/engineering-tools.md",
  "bounded_capabilities": [
    "ci.logs.read",
    "ci.artifact.read"
  ],
  "reference_status": "validated",
  "notes": "Proves the CI capability family reuses an existing SCM transport rather than a bespoke adapter."
}
