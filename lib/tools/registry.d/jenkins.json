{
  "schema": "agent-skills.tool-definition/v1",
  "id": "jenkins",
  "class": "REMOTE_SERVICE",
  "category": "ci-cd",
  "summary": "Standalone CI provider: build status, console logs, artifacts.",
  "capabilities": [
    "ci.run.read",
    "ci.logs.read",
    "ci.artifact.read",
    "ci.run.trigger"
  ],
  "transports": [
    {
      "kind": "mcp",
      "hint": "jenkins"
    },
    {
      "kind": "cli",
      "command": "jenkins",
      "probe": [
        "who-am-i"
      ]
    },
    {
      "kind": "api",
      "auth_service": "jenkins",
      "require": [
        "base_url",
        "user",
        "token"
      ],
      "secret": [
        "token"
      ]
    }
  ],
  "auth_service": "jenkins",
  "docs": "docs/engineering-tools.md",
  "bounded_capabilities": [
    "ci.logs.read",
    "ci.artifact.read"
  ],
  "reference_status": "validated",
  "notes": "Proves a CI provider that shares no transport with GitHub. Console logs are bounded reads."
}
