#!/usr/bin/env bash
# agent-skills — development install from a source checkout.
#
# This is no longer how Agent Skills is installed. Since v0.43.0 installation is
# owned by the first-party CLI, and the supported way to get it onto a machine
# is:
#
#     npx @wamalalawrence/agent-skills install
#
# after which everything runs through the durable `agent-skills` command.
#
# What remains here is a development convenience for people working on this
# repository: it installs the working tree you are standing in, as a
# development release, using the same one installation engine as every other
# path. It is a thin delegation, not a second installer — the whole point of
# v0.43.0 was that there is exactly one.
#
#     ./setup.init                 install this checkout as a dev release
#     ./setup.init --verify        check the resulting installation
#     ./setup.init --home DIR      install into a throwaway root
#
# Everything the old script did beyond that has been removed rather than
# carried into 1.0: the workspace `.env`, `.jira-config.yml`, the `.skills`
# symlink, PROJECTS_JSON discovery, and the Jira / Confluence / Sonar prompts.
# Installation never asked for a credential after v0.37.0; now it cannot.
# `agent-skills migrate` explains what to do with anything those left behind.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON3="${PYTHON3:-python3}"

ACTION="install"
PASS_THROUGH=()
HOME_DIR=""

usage() {
  cat <<'USAGE'
Usage: ./setup.init [options]

Install this source checkout as a development release. For a normal
installation use the CLI instead:

    npx @wamalalawrence/agent-skills install

Options:
  --verify              Check the installation and report problems (no writes)
  --update              Update this machine from the release source
  --check-updates       Compare the installed version against the latest release
  --home DIR            Install into this root instead of ~/.agent-skills
  --hosts a,b,c         Register only these host ids
  --all-hosts           Register every linkable host, detected or not
  --no-path-link        Do not link the launcher into a PATH directory
  --yes                 Accepted and ignored; nothing here prompts
  --help                Show this message

Removed in v0.43.0, with no replacement flag:
  --legacy-workspace, --workspace-root, --with-jira, --no-jira,
  --with-confluence, --with-sonar, --with-environments, --symlink, --no-symlink

  Those belonged to the pre-v0.37 workspace model, which wrote a `.env`, a
  `.jira-config.yml`, and a `.skills` symlink beside your clone. Nothing reads
  those as configuration any more except the access resolver, which will
  continue to read an existing `.env` for as long as you keep one. Run
  `agent-skills migrate` to see what is left behind and what to do with it, and
  `agent-skills access` to hold credentials properly.
USAGE
}

removed_flag() {
  printf './setup.init: %s was removed in v0.43.0\n\n' "$1" >&2
  printf 'Installation no longer configures projects or credentials. See:\n' >&2
  printf '  agent-skills migrate     what an old workspace layout leaves behind\n' >&2
  printf '  agent-skills access      how credentials are held now\n' >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verify) ACTION="verify"; shift ;;
    --update) ACTION="update"; shift ;;
    --check-updates) ACTION="check-updates"; shift ;;
    --home) HOME_DIR="${2:-}"; shift 2 ;;
    --home=*) HOME_DIR="${1#*=}"; shift ;;
    --hosts|--hosts=*|--all-hosts|--no-path-link|--quiet)
      PASS_THROUGH+=("$1")
      [[ "$1" == "--hosts" ]] && { PASS_THROUGH+=("${2:-}"); shift; }
      shift
      ;;
    --yes|-y) shift ;;
    --help|-h) usage; exit 0 ;;
    --legacy-workspace|--workspace-root|--workspace-root=*) removed_flag "$1" ;;
    --with-jira|--no-jira|--with-confluence|--no-confluence) removed_flag "$1" ;;
    --with-sonar|--no-sonar|--with-environments|--no-environments) removed_flag "$1" ;;
    --symlink|--no-symlink) removed_flag "$1" ;;
    --no-connectivity-check|--no-credential-probe) removed_flag "$1" ;;
    *) printf './setup.init: unknown option %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

cat <<BANNER
./setup.init is a development helper. The supported installation is:

    npx @wamalalawrence/agent-skills install

Installing this checkout (${SCRIPT_DIR}) as a development release.

BANNER

[[ -n "${HOME_DIR}" ]] && PASS_THROUGH+=("--home" "${HOME_DIR}")

case "${ACTION}" in
  install)
    exec "${PYTHON3}" "${SCRIPT_DIR}/scripts/install.py" install \
      --provider local --source "${SCRIPT_DIR}" --dev "${PASS_THROUGH[@]+"${PASS_THROUGH[@]}"}"
    ;;
  update)
    exec "${PYTHON3}" "${SCRIPT_DIR}/scripts/install.py" update \
      "${PASS_THROUGH[@]+"${PASS_THROUGH[@]}"}"
    ;;
  check-updates)
    exec "${PYTHON3}" "${SCRIPT_DIR}/scripts/install.py" check-updates \
      "${PASS_THROUGH[@]+"${PASS_THROUGH[@]}"}"
    ;;
  verify)
    exec bash "${SCRIPT_DIR}/bin/agent-skills" verify
    ;;
esac
