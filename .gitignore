# Real environment file — must NEVER be committed
.env
.env.local
.env.*.local

# Personal Jira CLI config (real one, generated from the example)
.jira-config.yml

# Skill caches and transient state
.skills
.cache/
.skills-cache/
.venv/
venv/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# Python bytecode caches
__pycache__/
*.pyc

# Logs
*.log

# npm bootstrap build output. `scripts/build-npm-bootstrap.sh` regenerates it
# from lib/asrelease and scripts/install.py, which are the only copies under
# version control. Committing the vendored copy would create a second
# installer that could silently drift from the first.
npm/vendor/
npm/LICENSE
npm/*.tgz
